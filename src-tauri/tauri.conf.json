{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC30 Nova",
  "version": "0.1.0",
  "identifier": "com.cc30.nova",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CC30 Nova 控制中心",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/native/InsydeDCHU.dll"],
    "shortDescription": "适用于 CLEVO Control Center 3.0 的硬件状态与电源、风扇管理工具",
    "longDescription": "提供 CPU 与 GPU 温度、风扇转速、电源模式、硬件信息与诊断功能，仅开放经过验证的电源和风扇设置。"
  }
}
